# Advocu MCP Server Configuration
# Copy this file to .env and fill in your tokens

# For Google Developer Experts (GDE)
# Get your token from: https://devlibrary.advocu.com/ -> Settings -> Integrations -> API
GDE_ACCESS_TOKEN=your_gde_token_here

# For Docker Captains
# Get your token from: Docker Captains portal -> Settings -> Integrations -> API
DOCKER_ACCESS_TOKEN=your_docker_token_here

# For Microsoft MVPs (optional - different API)
# Get your token from: MVP portal
MVP_ACCESS_TOKEN=your_mvp_token_here
MVP_USER_PROFILE_ID=your_profile_id_here

# Optional: Log level (DEBUG, INFO, WARNING, ERROR)
LOG_LEVEL=INFO
